# Copia este archivo a .env y configura las variables.
PORT=3000
JWT_SECRET=un-secreto-largo-y-aleatorio
DATABASE_URL=postgres://user:password@localhost:5432/animewatch

# Correo para el código de "olvidé mi contraseña".
# Con Gmail: activa la verificación en 2 pasos y crea una "contraseña de aplicación" en
# https://myaccount.google.com/apppasswords (no uses tu contraseña normal).
# Si se dejan vacías, en local el código se muestra por consola.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=contraseña-de-aplicacion
MAIL_FROM="AnimeWatch <tu-correo@gmail.com>"
